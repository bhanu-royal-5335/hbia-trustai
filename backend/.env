# Application
APP_NAME=HBIA-TrustAI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
VERIFICATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Database (SQLite default for seamless local run)
DATABASE_URL=sqlite+aiosqlite:///./hbia_dev.db
SYNC_DATABASE_URL=sqlite:///./hbia_dev.db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION=hbia_knowledge

# HBIA Configuration
MIN_TRUST_SCORE=75.0
MAX_CORRECTION_ITERATIONS=3
MAX_RETRIEVAL_DOCS=6
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
